{
  "name": "gateway-rivet-poc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "PoC (fork A): the waddling native gateway (DuckDB + birdshot + quack) running inside a Rivet actor, with birdshot enforcing through a TOKEN'd loopback quack client.",
  "scripts": {
    "dev": "tsx src/registry.ts",
    "proxy": "tsx src/proxy.ts",
    "verify": "tsx src/verify.ts",
    "verify:b": "tsx src/verify-b.ts",
    "verify:resumable": "tsx src/verify-resumable.ts",
    "verify:managed": "tsx src/verify-managed-db.ts",
    "verify:full": "tsx src/verify-full.ts",
    "diag:same-process": "tsx src/diag-same-process.ts",
    "diag:chunk": "tsx src/diag-chunk.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1070.0",
    "jose": "^6",
    "rivetkit": "2.3.0-rc.5"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
