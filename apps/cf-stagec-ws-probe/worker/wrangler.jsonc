{
  // Stage C workspace data-plane probe — the WorkspaceSandbox DO + its Sandbox
  // container (Model B). Deploy to a real Cloudflare account; this can ONLY be
  // validated deployed (the container build + native DuckDB run in the CF runtime,
  // and the presigned-R2 + intercept-TLS legs only exist there). Throwaway; do not
  // promote as-is.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-stagec-ws-probe",
  "main": "src/index.ts",

  // ≥2026-06-01: required for ctx.exports (the self-referencing Worker entrypoint the
  // @cloudflare/sandbox outbound-proxy routing depends on). An older date makes
  // ctx.exports undefined → container startup fails → exec()/containerFetch hang.
  // (Stage 0 + hop-probe finding.)
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // The workspace sidecar runs in a Cloudflare Container driven by the
  // WorkspaceSandbox DO (Sandbox ⊂ Container ⊂ DO). standard-1: a single DuckDB
  // process + a small encrypted file. max_instances 3 — the probe brings up 3 distinct
  // sandbox ids (session 1, session 2 cold-restore, wrong-key) concurrently.
  "containers": [
    {
      "class_name": "WorkspaceSandbox",
      "image": "../container/Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 3
    }
  ],

  // One Durable Object: the WorkspaceSandbox container. PRIVATE — no public route; the
  // Worker drives it via getSandbox(...).containerFetch / startProcess / exec only.
  "durable_objects": {
    "bindings": [
      { "class_name": "WorkspaceSandbox", "name": "WORKSPACE" }
    ]
  },

  // Containers REQUIRE their DO class to be SQLite-backed.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkspaceSandbox"] }
  ],

  // REAL R2 S3-API creds (the same token /probe/r2 proved), read by the DO to MINT
  // presigned URLs. They never enter the container — the DO signs, the sidecar fetches.
  "secrets_store_secrets": [
    {
      "binding": "R2_ACCESS_KEY_ID",
      "store_id": "121d675c4103466f90c6e1a97e1fd494",
      "secret_name": "r2-access-key-id"
    },
    {
      "binding": "R2_SECRET_ACCESS_KEY",
      "store_id": "121d675c4103466f90c6e1a97e1fd494",
      "secret_name": "r2-secret-access-key"
    }
  ],

  // R2 S3-API connection details (non-secret). R2_HOST is the egress-allowlist entry
  // (host only, no scheme) the DO passes to setAllowedHosts so the sidecar can reach
  // R2 to restore/persist its own encrypted .duckdb.
  "vars": {
    "R2_ENDPOINT": "https://866403f7ed22a791871b45539ac6fbd7.r2.cloudflarestorage.com",
    "R2_BUCKET": "waddling-ws-probe",
    "R2_REGION": "auto",
    "R2_HOST": "866403f7ed22a791871b45539ac6fbd7.r2.cloudflarestorage.com"
  }
}
