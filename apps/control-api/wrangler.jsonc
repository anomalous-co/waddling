{
  // Stage A connectivity-probe scaffold for the waddling control plane.
  //
  // This Worker exists to validate the three load-bearing Cloudflare bindings
  // (Hyperdrive → control DB, Secrets Store → encryption/master keys, R2 via
  // SigV4 presigned URLs) BEFORE the real control-plane port is built on top.
  // The /probe/* routes are temporary scaffolding and get deleted once the
  // real control plane lands.
  //
  // Bindings are deliberately limited to resources that EXIST today: Hyperdrive,
  // Secrets Store, and R2-by-credentials (no native R2 binding — we exercise the
  // presigned-URL path the data plane will use). Durable Object and Container
  // bindings are intentionally absent: those classes are not defined in this
  // Worker yet, and declaring bindings to undefined classes fails the deploy.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "waddling-control-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat"],

  // Control-plane database: PlanetScale Postgres reached through Hyperdrive
  // (port 5432, caching disabled). The Worker reads env.HYPERDRIVE.connectionString.
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "cbd2434e2b3043fa914156943178a856" }
  ],

  // Secrets Store bindings. MASTER_KEY is a Stage-A PLACEHOLDER; Stage B replaces
  // it with the real BETTER_AUTH_SECRET. The R2 creds are PLACEHOLDERs until a
  // real R2 S3 API token is minted and pushed via `wrangler secrets-store secret update`.
  "secrets_store_secrets": [
    {
      "binding": "MASTER_KEY",
      "store_id": "121d675c4103466f90c6e1a97e1fd494",
      "secret_name": "waddling-master-key"
    },
    {
      "binding": "R2_ACCESS_KEY_ID",
      "store_id": "121d675c4103466f90c6e1a97e1fd494",
      "secret_name": "r2-access-key-id"
    },
    {
      "binding": "R2_SECRET_ACCESS_KEY",
      "store_id": "121d675c4103466f90c6e1a97e1fd494",
      "secret_name": "r2-secret-access-key"
    }
  ],

  // Non-secret vars. R2 S3-API connection details (the access keys are secret,
  // see secrets_store above). Plus Better Auth / JWT / MCP / Stripe construction
  // vars — all PLACEHOLDER values for B1. BETTER_AUTH_SECRET is deliberately NOT
  // here: it is a Worker secret set via `wrangler secret put`. The Stripe keys are
  // placeholders; the Stripe client constructs without validating them.
  "vars": {
    "R2_ENDPOINT": "https://866403f7ed22a791871b45539ac6fbd7.r2.cloudflarestorage.com",
    "R2_BUCKET": "waddling-ws-probe",
    "R2_REGION": "auto",

    "BETTER_AUTH_URL": "https://waddling-control-api.mirri.workers.dev",
    "JWT_ISSUER": "https://waddling-control-api.mirri.workers.dev",
    "JWT_AUDIENCE_PREFIX": "waddling",
    "MCP_RESOURCE_URL": "https://waddling-control-api.mirri.workers.dev",

    "STRIPE_SECRET_KEY": "sk_test_placeholder_b1",
    "STRIPE_WEBHOOK_SECRET": "whsec_placeholder_b1",
    "STRIPE_PRICE_PRO": "price_placeholder_pro",
    "STRIPE_PRICE_ENTERPRISE": "price_placeholder_ent",

    // Gateway control-channel base URL (lib/gateway-client). PLACEHOLDER pointing
    // at the local demo gateway (http://localhost:9510, from apps/waddling/.env.local) —
    // this LOCAL value will NOT resolve from deployed workerd. Repoint to the
    // reachable Rivet/GCP gateway control port before the gateway routes go live;
    // Stage D replaces it with the gateway Durable Object.
    "GATEWAY_INTERNAL_URL": "http://localhost:9510",

    // Deployment posture. MUST be "production": the endpoints/:id/provision dev
    // stand-in is gated on this and fails OPEN (route enabled) when unset, which
    // would let a caller flip prod endpoints to running. Never leave unset on a
    // deployed Worker.
    "WADDLING_ENV": "production"
  }
}
