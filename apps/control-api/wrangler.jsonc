{
  // Stage A connectivity-probe scaffold for the waddling control plane.
  //
  // This Worker exists to validate the three load-bearing Cloudflare bindings
  // (Hyperdrive → control DB, Secrets Store → encryption/master keys, R2 via
  // SigV4 presigned URLs) BEFORE the real control-plane port is built on top.
  // The /probe/* routes are temporary scaffolding and get deleted once the
  // real control plane lands.
  //
  // Bindings are deliberately limited to resources that EXIST today: Hyperdrive,
  // Secrets Store, and R2-by-credentials (no native R2 binding — we exercise the
  // presigned-URL path the data plane will use). Durable Object and Container
  // bindings are intentionally absent: those classes are not defined in this
  // Worker yet, and declaring bindings to undefined classes fails the deploy.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "waddling-control-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "persist": true, "invocation_logs": true }
  },
  // Prepaid-credit duration-debit driver. Every 5 min the scheduled() handler closes
  // abandoned sessions past TTL and debits each closed-but-unbilled session's wall-clock
  // (the dominant COGS). Bounds the at-most-one-cron-interval billing lag; the connect/
  // per-query gates enforce the real-time cutoff off the cached balance.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Control-plane database: GCP Cloud SQL Postgres (instance waddling-main, db
  // waddling_control) reached through Hyperdrive on port 5432. The instance requires
  // mTLS client certs (TRUSTED_CLIENT_CERTIFICATE_REQUIRED) over a public IP; the
  // client cert + CA are attached to this Hyperdrive config (sslmode=verify-ca), since
  // workerd's own outbound TLS cannot present a client cert. The Worker just reads
  // env.HYPERDRIVE.connectionString.
  // Production origin: api.getwaddling.com (custom domain on the getwaddling.com
  // zone). Same registrable domain as the UI's app.getwaddling.com, so the session
  // cookie is first-party same-site (Domain=.getwaddling.com, SameSite=Lax) — the
  // shape every browser accepts without third-party-cookie blocking. The
  // *.workers.dev URL stays reachable too, but the auth/cookie/CORS config below
  // is keyed to the custom domain.
  "routes": [
    { "pattern": "api.getwaddling.com", "custom_domain": true }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "8a86652d8cbb439c911033f8d29dd573"
    }
  ],
  // Public-ish user avatar storage. Uploaded by POST /api/cp/account/avatar and
  // served (no auth) by GET /api/cp/account/avatar/:userId. Not lake data — a
  // separate bucket from the workspace/lake buckets.
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "waddling-avatars"
    }
  ],
  // Data plane (apps/dataplane), reached ONLY over this service binding — it is
  // private (workers_dev:false). gateway-client transports /gw/* here; sessions
  // connect/query call /configure + /query. Agent SQL still flows through the
  // workspace sidecar's birdshot-gated quack ATTACH (the single chokepoint).
  "services": [
    {
      "binding": "DATAPLANE",
      "service": "waddling-dataplane"
    }
  ],
  // Cloudflare Email Service (Email Sending) — transactional mail (verification,
  // password reset, org invites, billing dunning) via lib/email.sendEmail. The sender
  // is locked to noreply@getwaddling.com; `remote:true` makes `wrangler dev` deliver
  // for real (Email Sending is CF-only). Requires the domain onboarded in dash +
  // Email Sending beta enabled. See docs/cloudflare-email-service.md.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@getwaddling.com"],
      "remote": true
    }
  ],
  // Secrets Store bindings. MASTER_KEY is a Stage-A PLACEHOLDER; Stage B replaces
  // it with the real BETTER_AUTH_SECRET. The R2 creds are PLACEHOLDERs until a
  // real R2 S3 API token is minted and pushed via `wrangler secrets-store secret update`.
  "secrets_store_secrets": [
    {
      "binding": "MASTER_KEY",
      "store_id": "121d675c4103466f90c6e1a97e1fd494",
      "secret_name": "waddling-master-key"
    },
    {
      "binding": "R2_ACCESS_KEY_ID",
      "store_id": "121d675c4103466f90c6e1a97e1fd494",
      "secret_name": "r2-access-key-id"
    },
    {
      "binding": "R2_SECRET_ACCESS_KEY",
      "store_id": "121d675c4103466f90c6e1a97e1fd494",
      "secret_name": "r2-secret-access-key"
    }
  ],
  // Non-secret vars. R2 S3-API connection details (the access keys are secret,
  // see secrets_store above). Plus Better Auth / JWT / MCP / Stripe construction
  // vars — all PLACEHOLDER values for B1. BETTER_AUTH_SECRET is deliberately NOT
  // here: it is a Worker secret set via `wrangler secret put`. The Stripe keys are
  // placeholders; the Stripe client constructs without validating them.
  "vars": {
    "R2_ENDPOINT": "https://866403f7ed22a791871b45539ac6fbd7.r2.cloudflarestorage.com",
    "R2_BUCKET": "waddling-ws-probe",
    "R2_REGION": "auto",
    "BETTER_AUTH_URL": "https://api.getwaddling.com",
    "JWT_ISSUER": "https://api.getwaddling.com",
    "JWT_AUDIENCE_PREFIX": "waddling",
    "MCP_RESOURCE_URL": "https://api.getwaddling.com",
    // Cross-origin dashboard support: the UI render plane runs on app.getwaddling.com
    // and calls /api/cp/* + /api/auth/* here. WEB_ORIGIN is echoed in credentialed
    // CORS (no `*`) and added to Better Auth trustedOrigins. COOKIE_DOMAIN makes the
    // session cookie first-party across the two subdomains (SameSite=Lax + Secure).
    "WEB_ORIGIN": "https://app.getwaddling.com,https://getwaddling.com",
    "COOKIE_DOMAIN": ".getwaddling.com",
    // STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET are Worker SECRETS (set via
    // `wrangler secret put …`), not plaintext vars — a name can't be both. A real
    // (test-mode) STRIPE_SECRET_KEY flips `stripeConfigured` on (auth.ts).
    // Price ids below are TEST-mode, created idempotently (by lookup_key) via
    // `scripts/stripe-setup-products.mjs` — re-run with a live key + push as secrets for prod.
    // Starter $15/mo — created by scripts/stripe-setup-products.mjs (lookup_key
    // starter_monthly). Empty until the script is re-run; stripePlans() filters
    // unset prices so checkout degrades gracefully.
    "STRIPE_PRICE_STARTER": "",
    "STRIPE_PRICE_PRO": "price_1TlgZVDNZoqvxQqoVjX1v0yO",
    // 'scale' = the self-serve $199/mo tier (this $199 price was created as
    // enterprise_monthly before the tier split; relabelled scale_monthly by the
    // setup script). The sales-led `enterprise` tier has no self-serve price.
    "STRIPE_PRICE_SCALE": "price_1TlgZWDNZoqvxQqoTFuZKTdV",
    "STRIPE_PRICE_CREDIT_10": "price_1TlgZWDNZoqvxQqozUuYB4Co",
    "STRIPE_PRICE_CREDIT_25": "price_1TlgZXDNZoqvxQqokMAhJEPa",
    "STRIPE_PRICE_CREDIT_100": "price_1TlgZXDNZoqvxQqoLH4ZcQ4Y",
    // GCP Cloud SQL per-org managed Postgres catalog. PG_HOST/PG_PORT are the shared
    // instance's public host + port; provisionOrgDatabase uses them to mint each org's
    // sealed DSN for the gateway. control-api reaches the DB only via Hyperdrive (above),
    // so it needs no cert material here. Unset PG_HOST ⇒ /api/cp/catalog 503s (managed
    // catalog disabled) — safe to deploy unconfigured.
    "PG_HOST": "34.168.85.164",
    "PG_PORT": "5432",
    // (GATEWAY_INTERNAL_URL removed: the gateway now lives in the waddling-dataplane
    // worker's GatewayDO, reached over the DATAPLANE service binding — see services.)
    // Deployment posture. MUST be "production": the endpoints/:id/provision dev
    // stand-in is gated on this and fails OPEN (route enabled) when unset, which
    // would let a caller flip prod endpoints to running. Never leave unset on a
    // deployed Worker.
    "WADDLING_ENV": "production"
  }
}
