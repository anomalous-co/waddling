{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "waddling-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-18",
  // nodejs_compat: required by @opennextjs/cloudflare. global_fetch_strictly_public:
  // OpenNext's recommended flag so the worker's own asset/route fetches resolve publicly.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // One worker, two custom domains (host-split by src/middleware.ts):
  //   • getwaddling.com      — marketing (landing, docs, blog, customers,
  //                            pricing, enterprise, memory)
  //   • app.getwaddling.com  — the product (sign-in/up, dashboard, /link); the
  //                            only host that makes credentialed API calls, so it
  //                            alone is control-api's WEB_ORIGIN.
  // Both sit on the getwaddling.com zone → same registrable domain as
  // api.getwaddling.com, so the auth cookie is first-party same-site.
  // app.getwaddling.com is a Custom Domain (wrangler owns its DNS record). The
  // apex already has a proxied A/AAAA record on the zone, so it is attached as a
  // Worker ROUTE instead — a route binds to the existing proxied record rather
  // than creating one, avoiding the 409 a custom-domain attach hits on a name
  // that already has DNS.
  "routes": [
    { "pattern": "getwaddling.com/*", "zone_name": "getwaddling.com" },
    { "pattern": "app.getwaddling.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "head_sampling_rate": 1, "persist": true, "invocation_logs": true } },

  // ── SSR auth/session seam (resolved) ─────────────────────────────────────────
  // Two render-plane routes read the session at the server (the dashboard layout
  // gate + /link). They no longer open an in-process DB / Better Auth instance;
  // src/lib/control-api-server.ts forwards the inbound Cookie to the control-api
  // auth plane. It PREFERS this CONTROL_API service binding (worker-to-worker, no
  // public hop, domain-independent) and falls back to NEXT_PUBLIC_CONTROL_API_URL
  // when the binding is absent (single-origin local dev). So this worker needs NO
  // Hyperdrive / DB binding of its own.
  "services": [
    { "binding": "CONTROL_API", "service": "waddling-control-api" }
  ]

  // Build-time (NOT wrangler vars — NEXT_PUBLIC_* is inlined by `next build`):
  //   NEXT_PUBLIC_CONTROL_API_URL = https://api.<zone>   (the control-api origin;
  //   browser bundle for /api/cp/* + /api/auth/*, and the SSR helper's fallback
  //   when the CONTROL_API service binding is unavailable).
}
