{
  "name": "@waddling/app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "cf:build": "NEXT_PUBLIC_CONTROL_API_URL=${NEXT_PUBLIC_CONTROL_API_URL:-https://api.getwaddling.com} NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL:-https://getwaddling.com} NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL:-https://app.getwaddling.com} opennextjs-cloudflare build",
    "preview": "pnpm cf:build && opennextjs-cloudflare preview",
    "deploy": "pnpm cf:build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.6.19",
    "@better-auth/stripe": "^1.6.19",
    "@opennextjs/cloudflare": "^1.19.11",
    "@posthog/next": "^0.4.95",
    "@types/three": "^0.184.1",
    "@waddling/control-schema": "workspace:*",
    "better-auth": "^1.6.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fumadocs-core": "latest",
    "fumadocs-mdx": "latest",
    "fumadocs-ui": "latest",
    "jose": "^6",
    "lucide-react": "^1.20.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "posthog-js": "^1.156.0",
    "posthog-node": "^3.4.0",
    "radix-ui": "^1.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.11.0",
    "sonner": "^1.7.4",
    "stripe": "^18",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2",
    "@types/node": "^20",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3",
    "wrangler": "^4.102.0"
  }
}
