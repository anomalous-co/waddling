{
  // Stage 0 probe #1 Worker — THE GATE. Deploy this to a real Cloudflare account to
  // prove quack-over-HTTPS:443 works under the container egress allowlist while all
  // other egress is blocked. Throwaway; do not promote as-is.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-stage0-probe",
  "main": "src/index.ts",

  // nodejs_compat is required so @duckdb/node-api's deps resolve in the Worker build.
  // The date MUST be recent enough for `ctx.exports` (the self-referencing Worker
  // entrypoint exports the @cloudflare/sandbox outbound-proxy routing depends on);
  // an older date makes ctx.exports undefined → container.startup fails with
  // "unrecognized_error" → the container never starts and exec() hangs.
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // The Sandbox runs in a Cloudflare Container. The image is the SAME one the local
  // probes build (cloudflare/sandbox base + @duckdb/node-api + the probe scripts) so
  // there is no divergence between what we proved offline and what runs the gate.
  // instance_type standard-1: DuckDB + extensions + temp need more than `lite`.
  "containers": [
    {
      "class_name": "ProbeSandbox",
      "image": "../container/Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],

  // The Sandbox subclass is a Durable Object (Sandbox ⊂ Container ⊂ DurableObject).
  "durable_objects": {
    "bindings": [
      { "class_name": "ProbeSandbox", "name": "Sandbox" }
    ]
  },

  // Containers REQUIRE the DO class to be SQLite-backed.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProbeSandbox"] }
  ],

  // The one host the workspace container is allowed to reach. Replace with your
  // reachable quack gateway host (the existing Rivet/GCP gateway works for this
  // cross-cloud probe). Host ONLY — no scheme, no port. LAKE_TOKEN should be set as
  // a secret (`wrangler secret put LAKE_TOKEN`), not committed here.
  "vars": {
    "GATEWAY_HOST": "REPLACE_WITH_YOUR_GATEWAY_HOST"
  }
}
