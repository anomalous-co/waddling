{
  // Stage C/D full :443 loop probe — the CAPSTONE integration. Combines the three
  // proven lynchpins in ONE worker so the workspace's outbound handler can reach the
  // gateway over an in-worker DO binding (no cross-worker plumbing):
  //   #1 hop  : WorkspaceSandbox.outbound routes the one allowlisted quack:443 egress
  //             to the PRIVATE GatewayDO via its binding (never a public host);
  //   #2 gw   : GatewayDO boots the real packages/gateway (quack_serve + birdshot) and
  //             serves birdshot-gated quack in production RS256 mode;
  //   #3 ws   : WorkspaceSandbox is the agent's locked, isolated DuckDB workspace.
  // The new thing PROVEN here (explicitly out of scope for the gw-probe): raw quack
  // wire survives intercept → outbound handler → DO binding → containerFetch → the
  // gateway forwarder → quack_serve. Deploy-only (native DuckDB/quack/birdshot + the
  // CF egress interception exist only in the CF runtime). Throwaway.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-stagec-loop-probe",
  "main": "src/index.ts",

  // ≥2026-06-01: ctx.exports (the self-referencing entrypoint the @cloudflare/sandbox
  // outbound-proxy routing depends on) — older dates make it undefined → containers
  // never start. Same pin as the proven hop/gw/ws probes.
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // TWO container classes, each reusing the ALREADY-PROVEN image by Dockerfile path
  // (no duplication): the gateway image (DuckDB + quack + birdshot, baked binary) and
  // the workspace image (DuckDB, NO birdshot). wrangler builds each with the
  // Dockerfile's own directory as the build context.
  "containers": [
    {
      "class_name": "GatewayDO",
      "image": "../../cf-stagec-gw-probe/container/Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 2
    },
    {
      "class_name": "WorkspaceSandbox",
      "image": "../../cf-stagec-ws-probe/container/Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 2
    }
  ],

  // Both DOs are PRIVATE — no public route. The worker drives the workspace via SDK
  // methods; the workspace's outbound handler reaches the gateway via this GATEWAY
  // binding (the #1 hop, now carrying raw quack instead of a curl probe).
  "durable_objects": {
    "bindings": [
      { "class_name": "GatewayDO", "name": "GATEWAY" },
      { "class_name": "WorkspaceSandbox", "name": "WORKSPACE" }
    ]
  },

  // Containers REQUIRE their DO class to be SQLite-backed.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GatewayDO", "WorkspaceSandbox"] }
  ],

  // production posture (birdshot pushes RS256 auth → gates in production mode; a
  // dev-mode false-pass is asserted against by the verdict).
  "vars": {
    "WADDLING_ENV": "production"
  },

  // Persist logs + traces so the deployed loop (boot, quack tunnel, birdshot gating)
  // is queryable from the dashboard / wrangler tail.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "persist": true, "invocation_logs": true },
    "traces": { "enabled": true, "persist": true, "head_sampling_rate": 1 }
  }
}
