{
  // Stage D gateway probe — the waddling gateway as a PRIVATE CF Container Durable
  // Object, serving birdshot-gated quack in production RS256 mode. Deploy to a real
  // Cloudflare account; this can ONLY be validated deployed (the container build +
  // native DuckDB/quack/birdshot run in the CF runtime, not locally). Throwaway.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-stagec-gw-probe",
  "main": "src/index.ts",

  // ≥2026-06-01: required for ctx.exports (the self-referencing Worker entrypoint
  // the @cloudflare/sandbox outbound-proxy routing depends on). An older date makes
  // ctx.exports undefined → container startup fails → exec()/containerFetch hang.
  // (Stage 0 + hop-probe finding.)
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // The gateway runs in a Cloudflare Container driven by the GatewayDO (Sandbox ⊂
  // Container ⊂ DO). standard-2 (not standard-1): DuckDB + ducklake + quack + the
  // birdshot extension + an in-container quack client is heavier than the hop
  // probe's curl-only image.
  "containers": [
    {
      "class_name": "GatewayDO",
      "image": "../container/Dockerfile",
      "instance_type": "standard-2",
      // Raised from 1 so the /benchmark cold samples (a fresh container id each, no destroy)
      // can run concurrently. The probe is a manual test surface; idle containers sleep out.
      "max_instances": 12
    }
  ],

  // One Durable Object: the GatewayDO container. PRIVATE — no public route; the
  // Worker drives it via getSandbox(...).containerFetch only.
  "durable_objects": {
    "bindings": [
      { "class_name": "GatewayDO", "name": "GATEWAY" }
    ]
  },

  // Containers REQUIRE their DO class to be SQLite-backed.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GatewayDO"] }
  ],

  // CRITICAL: production env. The probe pushes auth into birdshot (RS256), so the
  // gateway gates in production mode; this var documents/forces the posture so a
  // dev-mode false-pass (which skips signature/iss/aud) can never be mistaken for a
  // real gating proof. The verdict additionally asserts birdshot_status().mode === rs256.
  "vars": {
    "WADDLING_ENV": "production"
  },

  // Persist logs + invocation logs so the deployed gateway's runtime output (boot,
  // birdshot gating) is queryable from the dashboard / `wrangler tail`.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
