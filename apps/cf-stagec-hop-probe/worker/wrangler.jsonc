{
  // Stage C lynchpin probe #1 — the outbound → DO-binding hop. Deploy to a real
  // Cloudflare account; this can ONLY be validated deployed (the outbound handler
  // runs in the runtime sidecar, not locally). Throwaway; do not promote as-is.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-stagec-hop-probe",
  "main": "src/index.ts",

  // Recent enough for ctx.exports (the self-referencing Worker entrypoint exports the
  // @cloudflare/sandbox outbound-proxy routing depends on); an older date makes
  // ctx.exports undefined → container.startup fails → exec() hangs. (Stage 0 finding.)
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // The Sandbox runs in a Cloudflare Container. Base sandbox image (no DuckDB needed
  // for this probe — it only curls). instance_type standard-1 to match Stage 0.
  "containers": [
    {
      "class_name": "HopProbeSandbox",
      "image": "../container/Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],

  // Two Durable Objects:
  //  • Sandbox    → the HopProbeSandbox container DO (Sandbox ⊂ Container ⊂ DO).
  //  • GATEWAY_DO → the internal gateway stand-in the outbound handler routes to.
  "durable_objects": {
    "bindings": [
      { "class_name": "HopProbeSandbox", "name": "Sandbox" },
      { "class_name": "GatewayStubDO", "name": "GATEWAY_DO" }
    ]
  },

  // Containers REQUIRE their DO class to be SQLite-backed; GatewayStubDO is declared
  // SQLite too (new DO classes default to SQLite on recent compat dates, and listing
  // it here is explicit + matches the container constraint).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HopProbeSandbox", "GatewayStubDO"] }
  ],

  // DNS-RESOLVABLE host whose real body ("Example Domain") differs from the DO body
  // ("OK-FROM-DO-BINDING"), so a pass proves the handler short-circuited to the DO.
  "vars": {
    "GATEWAY_HOST": "example.com"
  }
}
